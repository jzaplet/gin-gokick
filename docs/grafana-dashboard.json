      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(container_start_time_seconds{service_namespace=\"$project\",service_name=\"${project}_app\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true,
