{
  "uid": "<projectname>",
  "title": "<domain> - aplikace",
  "tags": [
    "<projectname>",
    "go",
    "gin"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Zdroj dat",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "job"
        },
        "definition": "label_values(up, job)",
        "refresh": 1,
        "current": {
          "text": "<projectname>",
          "value": "<projectname>"
        },
        "sort": 1
      },
      {
        "name": "route",
        "label": "Routa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_requests_total{job=\"$job\"}, route)",
          "refId": "route"
        },
        "definition": "label_values(http_requests_total{job=\"$job\"}, route)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "logs",
        "label": "Zdroj logů",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "project",
        "label": "Projekt",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${logs}"
        },
        "query": {
          "type": 1,
          "label": "project",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(project)",
        "refresh": 1,
        "current": {
          "text": "<projectname>",
          "value": "<projectname>"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Dostupnost",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{job=\"$job\"}",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "nedostupná",
                  "color": "red"
                },
                "1": {
                  "text": "běží",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
