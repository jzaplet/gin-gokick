{
  "uid": "<projectname>-runtime",
  "title": "<domain> - Runtime",
  "tags": [
    "<projectname>",
    "go",
    "gin"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "<domain>",
      "type": "dashboards",
      "tags": [
        "<projectname>"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "GlitchTip",
      "type": "link",
      "url": "<glitchtip>/<glitchtip-org>/issues",
      "targetBlank": true,
      "icon": "bolt"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(swarm_service_updated_timestamp_seconds{service_namespace=\"$project\",service_name=\"${project}_app\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Deploy",
        "textFormat": "{{service_name}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_namespace)",
          "refId": "project"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_namespace)",
        "refresh": 1,
        "current": {
          "text": "<stack>",
          "value": "<stack>"
        },
        "sort": 1
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "constant",
        "query": "<domain>",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Instances",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (instance) (go_goroutine_count{service_namespace=\"$project\"}))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "CPU (cores)",
