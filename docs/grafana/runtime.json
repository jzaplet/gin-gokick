        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(go_config_gogc_percent{service_namespace=\"$project\"})",
          "legendFormat": "GOGC %",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "GOMAXPROCS, the threads Go runs code on, and GOGC, the growth of the heap that starts a GC.",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "CPU (cores)",
