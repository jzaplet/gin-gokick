        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Failed tasks of the app in the last 15 minutes.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Goroutines",
      "datasource": {
        "type": "prometheus",
