          },
          "expr": "sum(glitchtip_unresolved_issues{project=~\"<projectname>-.+\"})",
          "legendFormat": "unresolved",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(glitchtip_issues_total{project=~\"<projectname>-.+\"}[$__range]))",
