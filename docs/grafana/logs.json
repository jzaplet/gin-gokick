{
  "uid": "<projectname>-logs",
  "title": "<domain> - logs",
  "tags": [
    "<projectname>",
    "go",
    "gin"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "<domain>",
      "type": "dashboards",
      "tags": [
        "<projectname>"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "GlitchTip",
      "type": "link",
      "url": "<glitchtip>/<glitchtip-org>/issues",
      "targetBlank": true,
      "icon": "bolt"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(swarm_service_updated_timestamp_seconds{service_namespace=\"$project\",service_name=\"${project}_app\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Deploy",
        "textFormat": "{{service_name}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, service_namespace)",
          "refId": "project"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, service_namespace)",
        "refresh": 1,
        "current": {
          "text": "<stack>",
          "value": "<stack>"
        },
        "sort": 1
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "constant",
        "query": "<domain>",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines by level",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (detected_level) (count_over_time({service_namespace=\"$project\", service_name=\"${project}_app\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Most frequent errors and warnings in range",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "topk(10, sum by (detected_level, msg, error, warning) (count_over_time({service_namespace=\"$project\", service_name=\"${project}_app\"} | detected_level=~\"error|warn\" | json msg, error, warning [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Lines",
              "detected_level": "Level",
              "msg": "Message",
              "error": "Error",
              "warning": "Warning"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Lines",
            "desc": true
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "4xx and 5xx by path",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (path, status) (count_over_time({service_namespace=\"$project\", service_name=\"${project}_app\"} | json msg, path, status | msg=\"http request\" | status >= 400 [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{status}} {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 3
    },
    {
      "type": "logs",
      "title": "Errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_namespace=\"$project\", service_name=\"${project}_app\"} | detected_level=~\"error|warn\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "id": 4
    },
    {
      "type": "logs",
      "title": "Business events",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_namespace=\"$project\", service_name=\"${project}_app\"} | json msg | msg=\"business event\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "id": 5
    },
    {
      "type": "logs",
      "title": "Other services of the stack",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_namespace=\"$project\", service_name!=\"${project}_app\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "id": 6
    },
    {
      "type": "logs",
      "title": "All logs of the app",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_namespace=\"$project\", service_name=\"${project}_app\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "id": 7
    }
  ]
}
